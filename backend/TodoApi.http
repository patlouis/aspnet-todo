@TodoApi_HostAddress = http://localhost:5199

### List all todos
GET {{TodoApi_HostAddress}}/todos
Accept: application/json

### Get one todo
GET {{TodoApi_HostAddress}}/todos/1
Accept: application/json

### Create a todo
POST {{TodoApi_HostAddress}}/todos
Content-Type: application/json

{
  "title": "Buy milk"
}

### Update a todo
PUT {{TodoApi_HostAddress}}/todos/1
Content-Type: application/json

{
  "title": "Buy oat milk",
  "isDone": true
}

### Delete a todo
DELETE {{TodoApi_HostAddress}}/todos/1

### Invalid: empty title (expect 400)
POST {{TodoApi_HostAddress}}/todos
Content-Type: application/json

{
  "title": "   "
}
