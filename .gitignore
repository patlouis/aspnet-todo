# ---------- Secrets & local config ----------
# Never commit credentials. Put local-only settings in these files instead.
.env
.env.*
!.env.example
*.local
appsettings.*.local.json
appsettings.Local.json
secrets.json
*.pfx
*.p12
*.pem
*.key

# ---------- Database ----------
# SQLite data is personal and recreated on startup (Database.Migrate()).
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---------- .NET (backend) ----------
bin/
obj/
*.user
*.suo
*.rsuser
.vs/
TestResults/
*.trx
*.coverage
coverage/

